{
  "experimentName": "Quantitative mental state attributions in language understanding (Exp 3)",
  "paper-title": "Quantitative mental state attributions in language understanding",
  "citation": "Jara-Ettinger, J., & Rubio-Fernandez, P. (2021). Quantitative mental state attributions in language understanding. Science Advances, 7(47). https://doi.org/10.1126/sciadv.abj0970",
  "year": 2021,
  "alias": "jaraettinger2021quantitative-exp3",
  "description": "You will play a coordination game with a virtual collaborator. Both of you have access to a visual display of 4 objects. Your collaborator will sometimes not be able to see the object enclosed in a black square. In a series of 12 trials, the virtual collaborator will give you instructions to select one of the four objects. Your task is to follow the instructions and also judge how certain you are that your collaborator knows about the object in the box.",
  "paperDOI": "https://doi.org/10.1126/sciadv.abj0970",
